{
  "name": "bundle",
  "version": "0.1.0",
  "module": "index.ts",
  "bin": {
    "bundle": "./index.ts"
  },
  "mikro-orm": {
    "preferTs": true,
    "configPaths": ["./mikro-orm.config.ts"]
  },
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun --watch index.ts",
    "bundle": "bun run index.ts",
    "orm": "bun --bun mikro-orm",
    "typecheck": "bun check",
    "test": "bun test",
    "graph:build": "bun run scripts/build-graph.ts",
    "graph:check": "bun run scripts/build-graph.ts --check"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.2.7",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@mikro-orm/core": "7.2.7",
    "@mikro-orm/mariadb": "7.2.7",
    "@mikro-orm/migrations": "7.2.7",
    "@mikro-orm/postgresql": "7.2.7",
    "@mikro-orm/seeder": "7.2.7",
    "@mikro-orm/sqlite": "7.2.7",
    "commander": "15.0.0",
    "tinyglobby": "0.2.17"
  }
}
