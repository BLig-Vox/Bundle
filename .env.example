# Bun loads .env automatically. Copy this file to .env if you need overrides.
DB_CONNECTION=sqlite
DB_DATABASE=.data/bundle.sqlite

# PostgreSQL:
# DB_CONNECTION=postgresql
# DB_DATABASE=bundle
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USERNAME=bundle
# DB_PASSWORD=

# MariaDB:
# DB_CONNECTION=mariadb
# DB_DATABASE=bundle
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=bundle
# DB_PASSWORD=

# For server databases, DATABASE_URL can replace the individual connection fields.
# Set DB_CONNECTION explicitly to match its protocol. URL-encode credentials.
# DATABASE_URL=postgresql://bundle:password@127.0.0.1:5432/bundle
# TLS: add ?sslmode=verify-full (require also verifies certificates), or disable.
# PostgreSQL also accepts schema=<name>. Other/repeated URL options are rejected.
# Configure provider-specific CA/driver options in src/database/config.ts.

# Optional complete named connections for --database <name>:
# BUNDLE_CONNECTIONS='{"testing":{"DB_CONNECTION":"sqlite","DB_DATABASE":".data/testing.sqlite"}}'
# Named targets replace all default DB connection fields, not just the database name.

# NODE_ENV=production or APP_ENV=production requires --force for migration/seed
# writes, install/status/check operations, and schema dumps.
# See docs/migrations.md for batch rollback, --pretend, --isolated, and schema dumps.
